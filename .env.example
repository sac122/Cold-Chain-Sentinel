# Cold-Chain Sentinel — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to source control.

# ── AWS Configuration ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
PREFIX=coldchain

# ── AWS IoT Core ──────────────────────────────────────────────────
# Retrieve from: aws iot describe-endpoint --endpoint-type iot:Data-ATS
AWS_IOT_ENDPOINT=xxxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
AWS_IOT_CLIENT_ID=fog-gateway-001

# ── Simulator ─────────────────────────────────────────────────────
NUM_DEVICES=10
PUBLISH_INTERVAL=2.0
RANDOM_SEED=42
CARGO_TYPE=frozen
# Inject scenarios (comma-separated): door_open,compressor_fail,gps_jump,sensor_stuck
INCIDENTS=

# ── Edge ──────────────────────────────────────────────────────────
EDGE_DOWNSAMPLE_N=10
EDGE_TEMP_MAX_C=-15.0
EDGE_DOOR_OPEN_SECONDS=300
EDGE_BATTERY_LOW_V=11.2
EDGE_EWMA_ALPHA=0.1
EDGE_ANOMALY_ZSCORE=3.0

# ── Fog ───────────────────────────────────────────────────────────
BUFFER_MAX_SIZE=10000
BUFFER_FLUSH_INTERVAL=10

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=ChangeMeNow123!

# ── Terraform ─────────────────────────────────────────────────────
TF_VAR_alert_email=your-email@example.com
TF_VAR_aws_region=us-east-1
TF_VAR_prefix=coldchain
TF_VAR_timestream_enabled=true
TF_VAR_grafana_enabled=true
